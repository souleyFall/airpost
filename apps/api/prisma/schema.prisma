// Schéma de la base d'airpost. Les migrations SQL (prisma/migrations) sont générées à partir de ce fichier.
//
// RGPD : on ne stocke que ce qui sert à postuler. Les données de tiers (contact recruteur) sont
// facultatives et supprimées avec la candidature ; voir docs/rgpd/registre-traitements.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OfferSource {
  LBA
  LBB
  ADZUNA
  /// Google Jobs via SerpApi : reprend des annonces de LinkedIn, Indeed, Welcome to the Jungle...
  GOOGLE_JOBS
  /// Glassdoor via SerpApi : annonces (extrait du texte), souvent des alternances.
  GLASSDOOR
  /// Alertes e-mail d'Indeed lues dans la boîte Gmail de l'utilisateur (aucun appel à Indeed).
  INDEED
  /// E-mails d'offres de LinkedIn lus dans la boîte Gmail de l'utilisateur (aucun appel à LinkedIn).
  LINKEDIN
}

enum ContractType {
  ALTERNANCE
  STAGE
  CDI
  CDD
  /// Entreprise qui recrute souvent (La Bonne Boîte) : pas d'annonce, on postule spontanément.
  SPONTANEE
  AUTRE
}

/// Comment la candidature part : par e-mail (brouillon Gmail) ou sur le site de l'entreprise.
enum ApplyChannel {
  EMAIL
  SITE
}

enum ApplicationStatus {
  TO_REVIEW
  VALIDATED
  DRAFT_CREATED
  APPLIED
  ACKNOWLEDGED
  INTERVIEW
  REJECTED
  NO_RESPONSE
  WITHDRAWN
}

enum ReplyKind {
  ACKNOWLEDGEMENT
  INTERVIEW
  REJECTION
  OTHER
}

/// Application mono-utilisateur : une seule ligne en pratique. Pas d'e-mail ici (minimisation).
/// État d'une connexion externe d'après son dernier appel. Jamais de message d'erreur d'origine (il pourrait contenir une URL ou une clé).
enum HealthStatus {
  OK
  /// Quota ou limite atteint : ne repart pas tant que la limite n'est pas levée.
  QUOTA
  /// Clé refusée.
  AUTH
  /// Panne ou surcharge, passagère en général.
  DOWN
  /// Non configurée (pas de clé).
  OFF
}

/// Santé de chaque connexion (une ligne par connexion : LBA, ADZUNA, GLASSDOOR, INDEED, GEMINI...). Mise à jour par les collectes, sans appel de test.
model ApiHealth {
  key       String       @id
  status    HealthStatus
  checkedAt DateTime
  lastOkAt  DateTime?
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  login        String   @unique
  /// Empreinte argon2 : jamais le mot de passe.
  passwordHash String
  createdAt    DateTime @default(now())

  profile  Profile?
  sessions Session[]
}

/// Session de connexion côté serveur. Le cookie contient un jeton aléatoire ; seule son empreinte
/// (SHA-256) est stockée : une fuite de la base ne permet pas de se connecter.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  /// Jeton anti-CSRF propre à la session, exigé dans l'en-tête X-CSRF-Token des requêtes qui modifient.
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Sert à purger les sessions expirées.
  @@index([expiresAt])
}

model Profile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  /// Contenu validé par un schéma Zod côté application (identité, parcours, compétences, préférences).
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Offer {
  id           String       @id @default(uuid(7)) @db.Uuid
  source       OfferSource
  /// Identifiant de l'offre chez la source : sert à ne pas la réimporter.
  externalId   String
  /// Empreinte (entreprise + intitulé + ville normalisés) pour repérer la même offre venant de deux sources.
  dedupKey     String
  title        String
  company      String
  city         String?
  postcode     String?
  latitude     Float?
  longitude    Float?
  description  String?
  applyUrl     String?
  /// Donnée d'un tiers (recruteur) : facultative, supprimée avec la candidature.
  contactEmail String?
  channel      ApplyChannel
  /// Plateforme d'origine quand la source est un agrégateur (« LinkedIn », « Indeed » pour Google Jobs).
  via          String?
  publishedAt  DateTime?
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  /// Type de contrat déduit de l'intitulé et de la description (aucune source ne le publie de façon fiable).
  contractType ContractType  @default(AUTRE)
  /// Distance à vol d'oiseau depuis le domicile du profil (km), recalculée à chaque collecte.
  distanceKm   Float?
  /// Taux de compatibilité sur 100, calculé par le modèle de langage (voir src/matching). Nul tant que non analysée.
  score        Int?
  /// Analyse du modèle : verdict, points forts et manques, brief de l'offre. Validée par un schéma Zod.
  analysis     Json?
  analyzedAt   DateTime?
  /// Écartée par l'IA (hors métier, contrat incompatible) : masquée du fil « À valider », mais conservée pour ne pas être réimportée puis réanalysée à chaque collecte.
  excluded     Boolean      @default(false)
  /// Empreinte du profil et du prompt au moment de l'analyse : si elle change, l'analyse est refaite.
  profileHash  String?

  application Application?

  @@unique([source, externalId])
  @@index([dedupKey])
  @@index([score])
  @@index([source])
  @@index([contractType])
  @@index([excluded])
  /// Sert à la purge des offres qui ne sont plus publiées (durée de conservation).
  @@index([lastSeenAt])
}

model Application {
  id            String            @id @default(uuid(7)) @db.Uuid
  offerId       String            @unique @db.Uuid
  status        ApplicationStatus @default(TO_REVIEW)
  subject       String?
  /// Lettre ou corps du mail, relus et validés par l'utilisateur avant tout brouillon.
  body          String?
  gmailDraftId  String?
  validatedAt   DateTime?
  appliedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@index([status])
  @@index([createdAt])
}

/// Réponse reçue par e-mail, classée automatiquement. On garde un extrait court, pas le message entier.
model Reply {
  id             String      @id @default(uuid(7)) @db.Uuid
  applicationId  String      @db.Uuid
  gmailMessageId String      @unique
  kind           ReplyKind
  receivedAt     DateTime
  /// 300 caractères au plus (contrôlé par l'application).
  snippet        String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
