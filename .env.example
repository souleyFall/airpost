# Modèle du fichier .env : il liste les variables attendues, sans aucun secret.
# Ce fichier-ci est versionné ; ton vrai .env ne l'est jamais.

# --- Base de données : lues par docker-compose pour créer le conteneur PostgreSQL ---
POSTGRES_USER=airpost
POSTGRES_PASSWORD=
POSTGRES_DB=airpost

# --- Base de données : lue par l'application pour s'y connecter (même utilisateur, même mot de passe) ---
DATABASE_URL=postgresql://airpost:MOT_DE_PASSE@localhost:5432/airpost

# --- API ---
# development | test | production
NODE_ENV=development
# Adresse d'écoute. 127.0.0.1 : uniquement cet ordinateur. Dans Docker, le conteneur écoute sur 0.0.0.0
# et le port n'est publié que sur 127.0.0.1 (voir docker-compose.yml).
API_HOST=127.0.0.1
API_PORT=3000
# Origine du front autorisée par CORS (schéma + hôte [+ port], sans « / » final). Vide : CORS désactivé.
WEB_ORIGIN=
# Limitation de débit : requêtes maximum par fenêtre (en millisecondes) et par adresse IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Cookie de session « Secure » (envoyé seulement en HTTPS). Vide : vrai en production, faux sinon.
# « false » seulement pour un usage local en http ; « true » dès que l'application est servie en HTTPS.
SESSION_COOKIE_SECURE=
# Collecte automatique des offres toutes les N heures (0 : désactivée, collecte à la demande seulement).
COLLECT_EVERY_HOURS=0
# Durée de conservation des offres sans candidature, en jours (7 à 365).
OFFER_RETENTION_DAYS=90

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- La Bonne Alternance ---
LBA_API_KEY=

# --- France Travail (La Bonne Boîte) ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Google Jobs via SerpApi (reprend des annonces de LinkedIn, Indeed, Welcome to the Jungle...) ---
# Facultatif : sans clé, la source est désactivée. Formule gratuite : 250 recherches par mois.
SERPAPI_KEY=
# Recherches au plus par collecte (pages comprises). 6 par défaut : environ une collecte par jour reste gratuite.
SERPAPI_MAX_SEARCHES=6

# --- Gmail ---
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Nombre de proxys de confiance devant l'API (0 = aucun). docker compose le met a 1 (nginx).
# TRUST_PROXY=0
